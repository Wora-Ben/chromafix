{
  "name": "chromafix",
  "version": "0.1.0",
  "description": "Tiny, framework-agnostic colorblind-safe palette switcher: a floating accessibility button that lets visitors pick a color-vision-deficiency type and swaps your site's CSS-variable colors for a distinguishable palette. Zero runtime dependencies.",
  "keywords": [
    "colorblind",
    "color-blindness",
    "palette",
    "accessibility",
    "a11y",
    "protanopia",
    "deuteranopia",
    "tritanopia",
    "cvd",
    "widget",
    "react"
  ],
  "license": "MIT",
  "author": "WORA-BEN",
  "homepage": "https://github.com/WORA-BEN/chromafix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WORA-BEN/chromafix.git"
  },
  "bugs": {
    "url": "https://github.com/WORA-BEN/chromafix/issues"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/use-client-banner.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^29",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8",
    "typescript": "^7.0",
    "vitest": "^4"
  },
  "engines": {
    "node": ">=18"
  }
}
