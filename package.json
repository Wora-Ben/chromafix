{
  "name": "chromafix-a11y",
  "version": "0.2.0",
  "description": "Colorblind accessibility widget: visitors pick their color-vision deficiency and your site's CSS-variable colors swap to a distinguishable palette. Framework-agnostic, zero dependencies.",
  "keywords": [
    "colorblind",
    "color-blindness",
    "palette",
    "accessibility",
    "a11y",
    "protanopia",
    "deuteranopia",
    "tritanopia",
    "cvd",
    "widget",
    "react"
  ],
  "license": "MIT",
  "author": "WORA-BEN",
  "homepage": "https://github.com/Wora-Ben/chromafix#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wora-Ben/chromafix.git"
  },
  "bugs": {
    "url": "https://github.com/Wora-Ben/chromafix/issues"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/use-client-banner.mjs",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:package": "publint && attw --pack . --profile node16",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.6",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.0.1",
    "publint": "^0.3.22",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
